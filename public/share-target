<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6f3ec" />
    <title>Updating MD Viewer…</title>
    <style>
      :root { font-family: Inter, system-ui, sans-serif; color: #171916; background: #f6f3ec; }
      body { min-height: 100vh; margin: 0; display: grid; place-items: center; }
      main { width: min(30rem, calc(100% - 3rem)); text-align: center; }
      p { color: #6d7068; line-height: 1.6; }
    </style>
  </head>
  <body>
    <main>
      <h1>Updating MD Viewer…</h1>
      <p>The newest offline version will open automatically.</p>
    </main>
    <script>
      (async () => {
        const appBase = new URL("./", location.href).href;
        const registrations = await navigator.serviceWorker?.getRegistrations?.() ?? [];
        await Promise.all(registrations
          .filter((registration) => registration.scope.startsWith(appBase))
          .map((registration) => registration.unregister()));

        const cacheNames = await caches.keys();
        await Promise.all(cacheNames
          .filter((name) => name.startsWith("workbox-precache") && name.includes(location.host))
          .map((name) => caches.delete(name)));

        location.replace(`${appBase}?updated=${Date.now()}`);
      })().catch(() => location.replace("./"));
    </script>
  </body>
</html>
